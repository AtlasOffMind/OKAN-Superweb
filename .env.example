# Base de datos PostgreSQL (local por defecto, vía docker compose).
DATABASE_URI=postgres://okan:okan@localhost:5432/okan

# Genera secretos propios para cada entorno; no uses estos marcadores en producción.
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32
PAYLOAD_OWNER_EMAIL=owner@example.com
# Solo para ejecutar npm run payload:create-owner localmente; no lo configures en el hosting.
PAYLOAD_OWNER_INITIAL_PASSWORD=replace-with-a-long-unique-password

# API key de Resend para el envío de email de formularios.
RESEND_API_KEY=
# Remitente verificado en Resend (ej. "OKAN <onboarding@resend.dev>").
RESEND_FROM=
# Destinatario de los formularios (por defecto info@escueladearteokan.com).
CONTACT_EMAIL=

# URL canónica pública del sitio (sin barra final), necesaria para sitemap y canonical.
NEXT_PUBLIC_SITE_URL=