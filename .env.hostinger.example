# Copy these keys to /opt/okan/.env on the VPS and replace every placeholder.
# Do not use this file as production credentials or commit real secrets.
POSTGRES_DB=okan
POSTGRES_USER=okan_app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET

PAYLOAD_SECRET=REPLACE_WITH_ANOTHER_RANDOM_HEX_SECRET
PAYLOAD_OWNER_EMAIL=your-admin-email@example.com
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: leave blank to store submissions in Payload without email alerts.
RESEND_API_KEY=
RESEND_FROM=
CONTACT_EMAIL=